@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu>
            <NavBarBrand><SectionOutlet SectionId="@NavBarBrandSection" /></NavBarBrand>
            <NavBarItems><SectionOutlet SectionId="@NavBarItemsSection" /></NavBarItems>
        </NavMenu>
    </div>
    <main>
        <div class="top-row px-4"><SectionOutlet SectionId="@HeaderSection" /></div>
        <article class="content px-4">@Body</article>
    </main>
</div>

@code {
    public static readonly object NavBarBrandSection = new();
    public static readonly object NavBarItemsSection = new();
    public static readonly object HeaderSection = new();
}