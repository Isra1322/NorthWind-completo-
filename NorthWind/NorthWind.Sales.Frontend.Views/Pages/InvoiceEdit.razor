@page "/invoices/{InvoiceId:int}/edit"
@using Microsoft.JSInterop
@using NorthWind.Sales.Entities.Dtos
@attribute [Authorize]
@implements IAsyncDisposable
@inject ICreateOrderGateway Gateway
@inject CreateOrderViewModel Order
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Editar factura @InvoiceId</PageTitle>
<h1>Editar factura @InvoiceId</h1>
@if (Busy && Invoice is null) { <p role="status">Cargando factura…</p> }
else if (Invoice is null && !string.IsNullOrEmpty(ErrorMessage)) { <div class="alert alert-danger" role="alert">@ErrorMessage</div> }
else if (Invoice is not null)
{
    <div class="card card-body mb-3">
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Número de factura</label><input class="form-control" value="@Invoice.Id" readonly /></div>
            <div class="col-md-5"><label class="form-label">Cliente</label><input class="form-control" value="@Invoice.CustomerDisplayName" readonly /></div>
            <div class="col-md-4"><label class="form-label">Cédula</label><input class="form-control" value="@(Invoice.CustomerIdentification ?? "No disponible")" readonly /></div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-12"><label class="form-label" for="shipAddress">Dirección de entrega</label><input id="shipAddress" class="form-control" maxlength="60" @bind="ShipAddress" /></div>
            <div class="col-md-4"><label class="form-label" for="shipCity">Ciudad</label><input id="shipCity" class="form-control" maxlength="15" @bind="ShipCity" /></div>
            <div class="col-md-4"><label class="form-label" for="shipCountry">País</label><input id="shipCountry" class="form-control" maxlength="15" @bind="ShipCountry" /></div>
            <div class="col-md-4"><label class="form-label" for="shipPostalCode">Código postal</label><input id="shipPostalCode" class="form-control" maxlength="10" @bind="ShipPostalCode" /></div>
        </div>
    </div>
    <div class="mb-3"><button class="btn btn-secondary" disabled="@Busy" @onclick="() => OpenProductSearch()">Agregar producto</button></div>
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th class="text-end">Id de producto</th><th class="text-start">Producto</th><th class="text-end">Precio</th><th class="text-end">Cantidad</th><th class="text-end">Stock disponible</th><th class="text-end">Importe</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var line in Order.OrderDetails)
        {
            <tr @key="line"><td class="text-end">@line.ProductId</td><td class="text-start">@line.ProductName</td><td class="text-end">@line.UnitPrice.ToString("N2")</td>
                <td><InputNumber class="form-control text-end" ParsingErrorMessage="Ingrese una cantidad válida." min="1" max="@line.UnitsInStock" @bind-Value="line.Quantity" /></td><td class="text-end">@line.UnitsInStock</td>
                <td class="text-end">@((line.UnitPrice * line.Quantity).ToString("N2"))</td>
                <td class="text-nowrap"><button class="btn btn-sm btn-outline-primary me-1" disabled="@Busy" @onclick="() => OpenProductSearch(line)">Reemplazar</button><button class="btn btn-sm btn-outline-danger" disabled="@Busy" @onclick="() => Remove(line)">Quitar</button></td></tr>
        }
        </tbody></table></div>
    @if (Order.OrderDetails.Count == 0) { <p class="text-danger">Agregue al menos un producto.</p> }
    <div class="mb-3"><div>Subtotal: @Subtotal.ToString("N2")</div><div>IVA (@((TaxRate * 100m).ToString("0.######")) %): @Tax.ToString("N2")</div><strong>Total a pagar: @Total.ToString("N2")</strong></div>
    @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="alert alert-danger" role="alert">@ErrorMessage</div> }
    @if (!string.IsNullOrWhiteSpace(SuccessMessage)) { <div class="alert alert-success" role="status">@SuccessMessage</div> }
    @if (PdfNeedsManualActions)
    {
        <div class="d-flex gap-2 mb-3">
            @if (PdfUrl is not null) { <a class="btn btn-outline-primary" href="@PdfUrl" target="_blank" rel="noopener">Ver PDF</a><a class="btn btn-primary" href="@PdfUrl" download="@PdfFileName">Descargar PDF</a> }
            else { <button class="btn btn-outline-primary" disabled="@Busy" @onclick="RetryPdfAsync">@(Busy ? "Preparando PDF…" : "Reintentar PDF")</button> }
        </div>
    }
    <div class="d-flex gap-2"><button class="btn btn-primary" disabled="@Busy" @onclick="RequestSave">Guardar cambios</button><button class="btn btn-outline-secondary" disabled="@Busy" @onclick="CancelEdit">Cancelar edición</button></div>
}

@if (SearchOpen) { <SalesSearchDialog Products="true" Order="@Order" Selected="SelectProduct" Close="CloseSearch" /> }
@if (ConfirmOpen)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirmEditTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 id="confirmEditTitle" class="modal-title fs-5">Guardar cambios</h2><button class="btn-close" aria-label="Cerrar" @onclick="CloseConfirmation"></button></div>
        <div class="modal-body">¿Está seguro de que desea guardar los cambios de esta factura?</div>
        <div class="modal-footer"><button class="btn btn-outline-secondary" disabled="@Busy" @onclick="CloseConfirmation">Cancelar</button><button class="btn btn-primary" disabled="@Busy" @onclick="ConfirmSaveAsync">@(Busy ? "Guardando…" : "Sí, guardar cambios")</button></div>
    </div></div></div><div class="modal-backdrop show"></div>
}

@code {
    [Parameter] public int InvoiceId { get; set; }
    private InvoiceDto? Invoice;
    private bool Busy, SearchOpen, ConfirmOpen, PdfNeedsManualActions;
    private string ErrorMessage = "", SuccessMessage = "", ShipAddress = "", ShipCity = "", ShipCountry = "", ShipPostalCode = "";
    private string? PdfUrl, PdfFileName;
    private int? SavedVersionNumber;
    private decimal TaxRate = .15m;
    private CreateOrderDetailViewModel? Replacing;
    private IJSObjectReference? Module;
    private decimal Subtotal => decimal.Round(Order.OrderDetails.Sum(x => x.UnitPrice * x.Quantity), 2, MidpointRounding.AwayFromZero);
    private decimal Tax => decimal.Round(Subtotal * TaxRate, 2, MidpointRounding.AwayFromZero);
    private decimal Total => Subtotal + Tax;

    protected override async Task OnParametersSetAsync()
    {
        if (Invoice?.Id == InvoiceId) return;
        try
        {
            Busy = true; ErrorMessage = ""; Order.OrderDetails.Clear();
            var taxSettings = await Gateway.GetTaxSettingsAsync();
            TaxRate = taxSettings.Enabled ? taxSettings.Rate : 0m;
            Invoice = await Gateway.GetInvoiceAsync(InvoiceId);
            if (Invoice is null) { ErrorMessage = "No se encontró la factura."; return; }
            ShipAddress = Invoice.ShipAddress; ShipCity = Invoice.ShipCity; ShipCountry = Invoice.ShipCountry; ShipPostalCode = Invoice.ShipPostalCode ?? "";
            foreach (var item in Invoice.Lines)
            {
                short available = item.Quantity;
                try
                {
                    var found = await Gateway.GetProductForEditAsync(item.ProductId);
                    if (found is not null) available = checked((short)Math.Min(short.MaxValue, found.UnitsInStock + item.Quantity));
                }
                catch (HttpRequestException) { }
                Order.OrderDetails.Add(new CreateOrderDetailViewModel { ProductId = item.ProductId, ProductName = item.ProductName, UnitPrice = item.UnitPrice, Quantity = item.Quantity, UnitsInStock = available });
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { ErrorMessage = "No se pudo cargar la factura. Intente nuevamente."; }
        finally { Busy = false; }
    }
    private void OpenProductSearch(CreateOrderDetailViewModel? replacing = null) { Replacing = replacing; SearchOpen = true; }
    private void CloseSearch() { SearchOpen = false; Replacing = null; }
    private Task SelectProduct(LookupItem item)
    {
        int productId = int.Parse(item.Id, System.Globalization.CultureInfo.InvariantCulture);
        int ownedQuantity = Invoice?.Lines.FirstOrDefault(x => x.ProductId == productId)?.Quantity ?? 0;
        item = item with { UnitsInStock = checked((short)Math.Min(short.MaxValue, item.UnitsInStock + ownedQuantity)) };
        if (Replacing is not null)
        {
            if (!Order.SelectProduct(item, Replacing)) return Task.CompletedTask;
        }
        else if (!Order.SelectProduct(item, null)) return Task.CompletedTask;
        CloseSearch(); return Task.CompletedTask;
    }
    private void Remove(CreateOrderDetailViewModel line) => Order.OrderDetails.Remove(line);
    private void RequestSave()
    {
        ErrorMessage = SuccessMessage = "";
        if (!TextInputRules.IsAddress(ShipAddress) || ShipAddress.Length > 60 || !TextInputRules.IsPlace(ShipCity) || ShipCity.Length is < 3 or > 15 || !TextInputRules.IsPlace(ShipCountry) || ShipCountry.Length is < 3 or > 15 || ShipPostalCode.Length > 10 || ShipPostalCode.Any(c => c is < '0' or > '9'))
        { ErrorMessage = "Revise los datos de entrega antes de guardar."; return; }
        if (Order.OrderDetails.Count == 0 || Order.OrderDetails.Any(x => x.Quantity <= 0 || x.Quantity > x.UnitsInStock) || Order.OrderDetails.Select(x => x.ProductId).Distinct().Count() != Order.OrderDetails.Count)
        { ErrorMessage = "Agregue productos únicos con cantidades válidas y dentro del stock disponible."; return; }
        ConfirmOpen = true;
    }
    private void CloseConfirmation() { if (!Busy) ConfirmOpen = false; }
    private void CancelEdit() => Navigation.NavigateTo("/invoices");
    private async Task RetryPdfAsync()
    {
        if (Invoice is null || SavedVersionNumber is not int versionNumber || Busy) return;
        Busy = true;
        try
        {
            var saved = await Gateway.GetInvoiceVersionAsync(InvoiceId, versionNumber).WaitAsync(TimeSpan.FromSeconds(30));
            if (saved is null) throw new HttpRequestException("No se encontró la versión guardada.");
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NorthWind.Sales.Frontend.Views/invoice.js");
            PdfUrl = await Module.InvokeAsync<string>("create", saved.PdfContent);
            SuccessMessage = "La factura actualizada está lista. Puede abrirla o descargarla.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or TimeoutException or JSException)
        { ErrorMessage = "No se pudo obtener el PDF. La factura ya está guardada; vuelva a intentarlo."; }
        finally { Busy = false; }
    }
    private async Task ConfirmSaveAsync()
    {
        if (Busy || Invoice is null) return;
        Busy = true; ErrorMessage = ""; SuccessMessage = ""; PdfNeedsManualActions = false;
        try
        {
            Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NorthWind.Sales.Frontend.Views/invoice.js");
            await Module.InvokeAsync<bool>("reserveFromClick");
            var update = new UpdateInvoiceDto(ShipAddress, ShipCity, ShipCountry, ShipPostalCode,
                Order.OrderDetails.Select(x => new UpdateInvoiceLineDto(x.ProductId, x.Quantity)).ToArray());
            var version = await Gateway.UpdateInvoiceAsync(InvoiceId, update).WaitAsync(TimeSpan.FromSeconds(30));
            SavedVersionNumber = version.VersionNumber;
            SuccessMessage = $"Factura N.º {InvoiceId} actualizada correctamente. Se creó la versión {version.VersionNumber}.";
            PdfFileName = $"Factura_{InvoiceId}_V{version.VersionNumber}.pdf";
            var saved = await Gateway.GetInvoiceVersionAsync(InvoiceId, version.VersionNumber).WaitAsync(TimeSpan.FromSeconds(30));
            if (saved is null) throw new HttpRequestException("No se pudo obtener el PDF de la versión guardada.");
            if (PdfUrl is not null) await Module.InvokeVoidAsync("releaseAfter", PdfUrl);
            PdfUrl = await Module.InvokeAsync<string>("create", saved.PdfContent);
            bool downloaded = await Module.InvokeAsync<bool>("download", PdfUrl, PdfFileName);
            bool opened = await Module.InvokeAsync<bool>("showReserved", PdfUrl);
            if (!opened) await Module.InvokeVoidAsync("closeReserved");
            if (!opened || !downloaded)
            {
                PdfNeedsManualActions = true;
                ErrorMessage = !opened && !downloaded
                    ? "La factura se guardó, pero el navegador no pudo abrir ni descargar el PDF. Use los botones para intentarlo manualmente."
                    : !opened ? "La factura se descargó, pero no se pudo abrir otra pestaña. Use Ver PDF."
                    : "La factura se abrió, pero la descarga automática no inició. Use Descargar PDF.";
            }
            Invoice = saved.Invoice;
            ConfirmOpen = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or TimeoutException or JSException)
        {
            try { if (Module is not null) await Module.InvokeVoidAsync("closeReserved"); } catch (JSException) { }
            ErrorMessage = SuccessMessage.Length > 0 ? "La factura se guardó, pero no se pudo abrir o descargar su PDF. Puede intentarlo desde los enlaces disponibles." :
                ex.Data["UserMessage"] as string ?? "No se pudo guardar la factura. Revise los datos y el stock disponible e intente nuevamente.";
            if (SuccessMessage.Length > 0) PdfNeedsManualActions = true;
        }
        finally { Busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        try { if (Module is not null) { await Module.InvokeVoidAsync("closeReserved"); if (PdfUrl is not null) await Module.InvokeVoidAsync("releaseAfter", PdfUrl); await Module.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
    }
}
